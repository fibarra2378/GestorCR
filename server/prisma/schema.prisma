generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AffiliateStatus {
  ACTIVO
  INACTIVO
  SUSPENDIDO
}

enum TicketCategory {
  CONSULTA
  RECLAMO
  MATRICULA
  CUOTA
  OTROS
}

enum TicketStatus {
  NUEVO
  EN_REVISION
  PENDIENTE_AFILIADO
  RESUELTO
  CERRADO
}

enum TicketPriority {
  BAJA
  MEDIA
  ALTA
  URGENTE
}

enum MessageSender {
  AFILIADO
  OPERADOR
  BOT
}

enum UserRole {
  ADMIN
  OPERADOR
}

model Affiliate {
  id         String          @id @default(uuid())
  dni        String          @unique
  matricula  String          @unique
  fullName   String
  phone      String?         @unique
  email      String?
  status     AffiliateStatus @default(ACTIVO)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  tickets    Ticket[]

  @@index([dni])
  @@index([matricula])
  @@index([phone])
}

enum TicketChannel {
  EMAIL
}

model Ticket {
  id           String         @id @default(uuid())
  code         String         @unique
  phone        String
  email        String?
  channel      TicketChannel  @default(EMAIL)

  category     TicketCategory @default(CONSULTA)
  status       TicketStatus   @default(NUEVO)
  priority     TicketPriority @default(MEDIA)
  
  affiliateId  String?
  affiliate    Affiliate?     @relation(fields: [affiliateId], references: [id])
  
  assignedToId String?
  assignedTo   User?          @relation(fields: [assignedToId], references: [id])

  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  messages     Message[]

  @@index([status])
  @@index([phone])
  @@index([email])
}

model Message {
  id             String        @id @default(uuid())
  ticketId       String
  ticket         Ticket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender         MessageSender
  body           String
  whatsappId     String?
  emailMessageId String?
  createdAt      DateTime      @default(now())
}


model User {
  id           String     @id @default(uuid())
  username     String     @unique
  passwordHash String
  name         String
  role         UserRole   @default(OPERADOR)
  createdAt    DateTime   @default(now())
  tickets      Ticket[]
  auditLogs    AuditLog[]
}

model BotSession {
  id               String   @id @default(uuid())
  phone            String   @unique
  step             String   // e.g. "AWAITING_IDENTITY", "AWAITING_CATEGORY"
  tempValue        String?
  attempts         Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  entity    String
  entityId  String?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  details   String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

